# ---------------------------------------------------------------------
# 1. CREDENCIAIS E RECURSOS DO SNOWFLAKE
# ---------------------------------------------------------------------
DBT_SNOWFLAKE_ACCOUNT=sfedu02-gfb24387
DBT_SNOWFLAKE_USER=DRAGON
DBT_SNOWFLAKE_DATABASE=DRAGON_DB
DBT_SNOWFLAKE_ROLE=TRAINING_ROLE
DBT_SNOWFLAKE_WAREHOUSE=DRAGON_WH
DBT_SNOWFLAKE_SCHEMA=MUNKA_RAW
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/dags/rsa_key.p8

# ---------------------------------------------------------------------
# 2. CREDENCIAIS E RECURSOS DA AWS S3
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=COLOQUE_SUA_CHAVE_AQUI
AWS_SECRET_ACCESS_KEY=COLOQUE_SEU_SECRET_AQUI
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET_NAME=munka-dev-070980587239-us-east-2

# ---------------------------------------------------------------------
# 3. CONFIGURAÇÕES DO APACHE AIRFLOW
# ---------------------------------------------------------------------
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_CUSTOM_IMAGE_NAME=airflow-dbt-snowflake:2.10.0
